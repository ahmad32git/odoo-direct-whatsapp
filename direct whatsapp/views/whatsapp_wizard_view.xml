<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_message_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.message.wizard.form</field>
        <field name="model">whatsapp.message.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <group>
                    <field name="phone"
                           placeholder="+966500000000"
                           widget="phone"/>
                </group>
                <group>
                    <field name="message"
                           nolabel="1"
                           placeholder="Type your message here…"
                           widget="text"/>
                </group>
                <footer>
                    <button name="action_send"
                            type="object"
                            string="Send via WhatsApp"
                            class="btn-success"
                            close="True"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
